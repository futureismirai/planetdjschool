// Planet DJ School - lesson booking data model
// PostgreSQL を使用(Vercelなどのサーバーレス環境ではSQLiteが利用できないため)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lesson {
  id             String    @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  maxSlots       Int       @default(3)
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([datetime])
}

model Booking {
  id             String    @id @default(cuid())
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String?
  studentPhone   String?
  note           String?
  /// 生徒別ページで管理者が記入する、このレッスンでの進捗コメント(noteとは別)
  comment        String?
  /// commentが最後に保存された日時。生徒一覧の並び替え(更新順)に使用する。
  commentUpdatedAt DateTime?
  reminderSentAt DateTime?
  /// 次のレッスン案内メールを送信した日時(グループレッスン修了者への手動案内ボタン用)
  nextLessonEmailSentAt DateTime?
  /// Lesson 3受講後のアンケート依頼メールを送信した日時(自動送信、翌日にcronで送信)
  lesson3SurveyEmailSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([lessonId])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 体験会。生徒には非公開、管理者が参加者を把握するためだけのもの。
model TrialSession {
  id             String            @id @default(cuid())
  datetime       DateTime
  instructorName String
  maxSlots       Int               @default(3)
  location       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  participants   TrialParticipant[]

  @@index([datetime])
}

model TrialParticipant {
  id             String       @id @default(cuid())
  trialSessionId String
  trialSession   TrialSession @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String
  note           String?
  reminderSentAt DateTime?
  /// 体験会受講後のお礼メールを送信した日時。送信済みの場合、体験会画面から送信ボタンを非表示にする。
  thankYouEmailSentAt DateTime?
  /// ご入会案内(お礼とお振込み案内)メールを送信した日時。送信済みの場合、体験会画面から送信ボタンを非表示にする。
  membershipEmailSentAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([trialSessionId])
}

/// 個別レッスン。生徒には非公開、管理者が把握するためだけのもの。1回あたり1名まで。
model IndividualLesson {
  id             String                  @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  location       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  participants   IndividualParticipant[]

  @@index([datetime])
}

model IndividualParticipant {
  id                 String           @id @default(cuid())
  individualLessonId String
  individualLesson   IndividualLesson @relation(fields: [individualLessonId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  note               String?
  /// 生徒別ページで管理者が記入する、このレッスンでの進捗コメント(noteとは別)
  comment            String?
  /// commentが最後に保存された日時。生徒一覧の並び替え(更新順)に使用する。
  commentUpdatedAt   DateTime?
  reminderSentAt     DateTime?
  /// Lesson 3受講後のアンケート依頼メールを送信した日時(自動送信、翌日にcronで送信)
  lesson3SurveyEmailSentAt DateTime?
  createdAt          DateTime         @default(now())

  @@index([individualLessonId])
}

/// 個別レッスンの日程調整依頼。生徒に候補日の提示を依頼し、回答された候補の中から
/// 管理者が最終日程を確定するために使用する。
model ScheduleRequest {
  id                String              @id @default(cuid())
  token             String              @unique @default(cuid())
  studentName       String
  studentEmail      String
  instructorName    String?
  /// 候補日として提示できる期間(依頼日から2週間)
  windowStart       DateTime
  windowEnd         DateTime
  /// 生徒が候補提出時に入力する備考
  note              String?
  /// "pending"(回答待ち/確定待ち) | "confirmed"(確定済み)
  status            String              @default("pending")
  confirmedDatetime DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime            @default(now())
  candidates        ScheduleCandidate[]

  @@index([token])
}

model ScheduleCandidate {
  id                String          @id @default(cuid())
  scheduleRequestId String
  scheduleRequest   ScheduleRequest @relation(fields: [scheduleRequestId], references: [id], onDelete: Cascade)
  startDatetime     DateTime
  endDatetime       DateTime
  createdAt         DateTime        @default(now())

  @@index([scheduleRequestId])
}

/// デビューイベント(生徒が出演するイベント)の開催枠。管理者が作成する。
model DebutEvent {
  id              String                  @id @default(cuid())
  startDatetime   DateTime
  endDatetime     DateTime
  venue           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  participants    DebutEventParticipant[]
  inviteResponses EventInviteResponse[]

  @@index([startDatetime])
}

/// デビューイベントへの参加者。管理者が手動で追加した生徒と、
/// イベント出演案内メールの回答ページから自動反映された生徒の両方を保持する。
model DebutEventParticipant {
  id           String     @id @default(cuid())
  eventId      String
  event        DebutEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String
  /// "participating"(参加できる) | "declined"(参加できない) | "not_interested"(参加を希望しない) | "pending"(管理者が追加したのみ、未回答)
  status       String     @default("pending")
  /// "admin"(管理者が手動追加) | "response"(回答ページからの反映)
  source       String     @default("admin")
  respondedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([eventId, studentEmail])
  @@index([eventId])
}

/// イベント出演案内メールの回答用トークン。公開回答ページ(/event-response/[token])で
/// 参加可否と受講後アンケートに回答してもらうために使用する。
model EventInviteResponse {
  id                  String     @id @default(cuid())
  token               String     @unique @default(cuid())
  eventId             String
  event               DebutEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentName         String
  studentEmail        String
  /// "pending"(回答待ち) | "answered"(回答済み)
  status              String     @default("pending")
  participationAnswer String?
  submittedAt         DateTime?
  createdAt           DateTime   @default(now())

  @@index([token])
  @@index([eventId])
}

/// 受講後アンケートの回答。イベント出演の参加可否とは別に、管理画面の
/// 「受講後アンケート」ページに一覧表示するために使用する。
model SurveyResponse {
  id                 String   @id @default(cuid())
  studentName        String
  studentEmail       String
  djName             String
  joinStatus         String
  lessonSufficiency  String
  moreToLearn        String?
  wantsMoreLessons   String
  improvements       String?
  message            String?
  submittedAt        DateTime @default(now())

  @@index([studentEmail])
}
