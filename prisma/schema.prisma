// Planet DJ School - lesson booking data model
// PostgreSQL を使用(Vercelなどのサーバーレス環境ではSQLiteが利用できないため)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lesson {
  id             String    @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  maxSlots       Int       @default(3)
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([datetime])
}

model Booking {
  id             String    @id @default(cuid())
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String?
  studentPhone   String?
  note           String?
  /// 生徒別ページで管理者が記入する、このレッスンでの進捗コメント(noteとは別)
  comment        String?
  /// commentが最後に保存された日時。生徒一覧の並び替え(更新順)に使用する。
  commentUpdatedAt DateTime?
  reminderSentAt DateTime?
  /// 次のレッスン案内メールを送信した日時(グループレッスン修了者への手動案内ボタン用)
  nextLessonEmailSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([lessonId])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 体験会。生徒には非公開、管理者が参加者を把握するためだけのもの。
model TrialSession {
  id             String            @id @default(cuid())
  datetime       DateTime
  instructorName String
  maxSlots       Int               @default(3)
  location       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  participants   TrialParticipant[]

  @@index([datetime])
}

model TrialParticipant {
  id             String       @id @default(cuid())
  trialSessionId String
  trialSession   TrialSession @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String
  note           String?
  reminderSentAt DateTime?
  /// 体験会受講後のお礼メールを送信した日時。送信済みの場合、体験会画面から送信ボタンを非表示にする。
  thankYouEmailSentAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([trialSessionId])
}

/// 個別レッスン。生徒には非公開、管理者が把握するためだけのもの。1回あたり1名まで。
model IndividualLesson {
  id             String                  @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  location       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  participants   IndividualParticipant[]

  @@index([datetime])
}

model IndividualParticipant {
  id                 String           @id @default(cuid())
  individualLessonId String
  individualLesson   IndividualLesson @relation(fields: [individualLessonId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  note               String?
  /// 生徒別ページで管理者が記入する、このレッスンでの進捗コメント(noteとは別)
  comment            String?
  /// commentが最後に保存された日時。生徒一覧の並び替え(更新順)に使用する。
  commentUpdatedAt   DateTime?
  reminderSentAt     DateTime?
  createdAt          DateTime         @default(now())

  @@index([individualLessonId])
}

/// イベントオーガナイザーツール: イベント（複数日・複数フロア開催に対応）
model Event {
  id        String     @id @default(cuid())
  name      String
  memo      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  days      EventDay[]
}

/// イベントの開催日（1イベントに複数日を追加可能）
model EventDay {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  label     String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  floors    EventFloor[]

  @@index([eventId])
}

/// 開催日ごとのフロア（1日に複数フロアを追加可能）。フロアごとにタイムテーブルを作成する
model EventFloor {
  id         String          @id @default(cuid())
  eventDayId String
  eventDay   EventDay        @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  name       String
  /// フロア全体の開始・終了時刻("HH:mm"形式)。終了が開始以前の場合は日をまたぐものとして扱う
  startTime  String
  endTime    String
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  slots      TimetableSlot[]

  @@index([eventDayId])
}

/// タイムテーブルの各出演枠
model TimetableSlot {
  id            String     @id @default(cuid())
  eventFloorId  String
  eventFloor    EventFloor @relation(fields: [eventFloorId], references: [id], onDelete: Cascade)
  performerName String
  /// InstagramなどSNSのアカウント名（任意、@は含めない）
  snsHandle     String?
  startTime     String
  endTime       String
  /// 自動作成時に時間を固定して配置した出演者かどうか
  isFixed       Boolean    @default(false)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([eventFloorId])
}

/// イベントオーガナイザーツール: 出演者名とSNSアカウントの候補（入力時のオートコンプリート用）
model Performer {
  id        String   @id @default(cuid())
  name      String   @unique
  /// InstagramなどSNSのアカウント名（任意、@は含めない）
  snsHandle String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// イベントオーガナイザーツール: 出演者一覧（複数出演者のSNSをまとめてコピーするためのリスト）
model PerformerRoster {
  id        String                 @id @default(cuid())
  name      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  entries   PerformerRosterEntry[]
}

/// 出演者一覧の1行分（出演者名・SNSアカウント）
model PerformerRosterEntry {
  id                String          @id @default(cuid())
  performerRosterId String
  performerRoster   PerformerRoster @relation(fields: [performerRosterId], references: [id], onDelete: Cascade)
  name              String
  /// InstagramなどSNSのアカウント名（任意、@は含めない）
  snsHandle         String?
  order             Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([performerRosterId])
}

/// イベントオーガナイザーツール: 会場の保存・リスト化
model Venue {
  id         String       @id @default(cuid())
  name       String
  address    String?
  access     String?
  /// 開催条件
  conditions String?
  /// 機材情報
  equipment  String?
  /// 場所の注意事項
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  photos     VenuePhoto[]
}

/// 会場の宣材写真
model VenuePhoto {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// base64エンコードされた画像データ(data URL)
  dataUrl   String   @db.Text
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([venueId])
}
