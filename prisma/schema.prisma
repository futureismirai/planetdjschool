// Planet DJ School - lesson booking data model
// PostgreSQL を使用(Vercelなどのサーバーレス環境ではSQLiteが利用できないため)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lesson {
  id             String    @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  maxSlots       Int       @default(3)
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([datetime])
}

model Booking {
  id             String    @id @default(cuid())
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String?
  studentPhone   String?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([lessonId])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 体験会。生徒には非公開、管理者が参加者を把握するためだけのもの。
model TrialSession {
  id             String            @id @default(cuid())
  datetime       DateTime
  instructorName String
  maxSlots       Int               @default(3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  participants   TrialParticipant[]

  @@index([datetime])
}

model TrialParticipant {
  id             String       @id @default(cuid())
  trialSessionId String
  trialSession   TrialSession @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  studentName    String
  studentEmail   String
  note           String?
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([trialSessionId])
}

/// 個別レッスン。生徒には非公開、管理者が把握するためだけのもの。1回あたり1名まで。
model IndividualLesson {
  id             String                  @id @default(cuid())
  name           String
  datetime       DateTime
  instructorName String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  participants   IndividualParticipant[]

  @@index([datetime])
}

model IndividualParticipant {
  id                 String           @id @default(cuid())
  individualLessonId String
  individualLesson   IndividualLesson @relation(fields: [individualLessonId], references: [id], onDelete: Cascade)
  studentName        String
  studentEmail       String
  note               String?
  reminderSentAt     DateTime?
  createdAt          DateTime         @default(now())

  @@index([individualLessonId])
}
